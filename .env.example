# Telegram (REQUIRED — free from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=YourBotUsername

# Helius (REQUIRED — free tier at helius.dev)
HELIUS_API_KEY=your_helius_api_key_here

# Optional fallback RPCs
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Database
DATABASE_URL=sqlite+aiosqlite:///rugscore.db

# Cache
CACHE_TTL_SECONDS=60

# Limits
ANALYSIS_TIMEOUT_SECONDS=8
MAX_CONCURRENT_ANALYSES=20
LOG_LEVEL=INFO

# Admin (comma-separated Telegram user IDs — get yours via @userinfobot)
ADMIN_IDS=123456789,987654321

# Optional — SOL wallet for /donate command
DONATE_WALLET=

# Optional — Telegram channel for auto-reports (e.g. @YourChannel or -100xxxx)
CHANNEL_ID=
